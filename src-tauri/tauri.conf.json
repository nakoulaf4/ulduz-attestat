{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ulduz",
  "version": "3.3.0",
  "identifier": "az.ulduz.attestat",
  "build": {
    "frontendDist": "../site"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Ulduz — DİM Attestat",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24,
      "versionCode": 3030000
    },
    "iOS": {
      "minimumSystemVersion": "14.0"
    }
  }
}
